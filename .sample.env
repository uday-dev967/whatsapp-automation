PORT=5051
NODE_ENV=development

# MongoDB
DATABASE=mongodb+srv://<user>:<PASSWORD>@<cluster>.mongodb.net/whatsapp-automation?retryWrites=true&w=majority&appName=Cluster0
DATABASE_PASSWORD=

# WhatsApp — remote mode (recommended): run OpenWA in a separate terminal
WA_ENABLED=true
WA_SERVER_URL=http://localhost:8002
WA_API_KEY=dev-api-key
WA_SERVER_PORT=8002
WA_SESSION_ID=whatsapp-automation-poc
# WA_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# QR/auth timeouts are set in wa/cli.config.json (do not use WA_QR_TIMEOUT=0 here — it breaks parsing)

# Scheduler
SCHEDULER_ENABLED=true
CRON_SCHEDULE=*/5 * * * *
CRON_TIMEZONE=Asia/Kolkata
